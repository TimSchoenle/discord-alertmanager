# Default: normalize everything Git considers text to LF. Authored on `core.autocrlf = true`
# machines but built and byte-compared by Linux runners, so this is the baseline every rule
# below only needs to add diff/linguist behaviour to, not line endings.
* text=auto eol=lf

# Diff drivers: anchor hunks on the enclosing item instead of the nearest blank line. Git ships
# no built-in driver for TOML/SQL/Dockerfile, so those stay on the default hunk header.
*.rs text diff=rust
*.sh text diff=bash
*.md text diff=markdown
*.json text diff=json

# Rendered/generated text still needs `text=auto eol=lf` above; these add linguist markers only.
Cargo.lock linguist-generated
CHANGELOG.md linguist-generated
README.md linguist-generated
config.example.toml linguist-generated
docs/config.md linguist-generated
docs/config.json linguist-generated
docs/config.contract.json linguist-generated

# Captured API payloads, not hand-authored fixtures; keep them out of language stats and diffs.
crates/discord-alertmanager-am/tests/fixtures/*.json linguist-generated

# Prose that should count as documentation, not as a language sample.
CONTRIBUTING.md linguist-documentation
SECURITY.md linguist-documentation

# Read as a text region rather than as a build input: the `config-contract` action cuts the
# `terrace-config:labels` block out of it and compares it against the generator's output.
Dockerfile text

# Binary safety net, in case one ever lands in the tree.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
