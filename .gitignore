/target
**/*.rs.bk
Cargo.lock.orig

# Local database URLs for `cargo sqlx prepare`; the checked-in `.sqlx/` caches are the artefact.
.env.local

# Editor / tooling state
/.idea/
/.serena/
/.vscode/

# insta review leftovers
**/*.snap.new

# The local configuration layer. It holds the bot token and the ingest webhook token on a
# developer machine, and `DAM_CONFIG` defaults to it, so it is the one file in this tree that a
# working checkout is expected to have and no checkout may ever commit.
/config.toml

# `docker buildx build --target contract-export --output type=local,dest=./contract-out` writes
# here. The committed copy of the same document is docs/config.contract.json.
/contract-out/
