  "query": "SELECT fingerprint, labels_hash, group_key, labels, annotations, starts_at, ends_at, generator_url, status, am_state, silenced_by, inhibited_by, first_seen_at, last_seen_at, resolved_at, flap_count, updated_at FROM alerts WHERE (cardinality($1::text[]) = 0 OR status = ANY($1)) AND (cardinality($2::text[]) = 0 OR severity = ANY($2)) AND NOT EXISTS (SELECT 1 FROM unnest($3::text[], $4::text[], $5::bool[]) AS matcher (name, value, equal) WHERE (COALESCE(alerts.labels ->> matcher.name, '') = matcher.value) <> matcher.equal) AND ($6::text IS NULL OR EXISTS (SELECT 1 FROM notifications WHERE notifications.dedupe_key = 'a:' || alerts.fingerprint AND notifications.state = $6)) ORDER BY last_seen_at DESC, fingerprint LIMIT $7 OFFSET $8",
