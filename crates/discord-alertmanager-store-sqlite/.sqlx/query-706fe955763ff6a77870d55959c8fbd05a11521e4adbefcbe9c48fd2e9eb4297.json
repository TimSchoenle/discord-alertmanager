{
  "db_name": "SQLite",
  "query": "SELECT fingerprint AS \"fingerprint!\", labels_hash, group_key, labels, annotations, starts_at, ends_at, generator_url, status, am_state, silenced_by, inhibited_by, first_seen_at, last_seen_at, resolved_at, flap_count, updated_at FROM alerts WHERE (json_array_length(?1) = 0 OR status IN (SELECT value FROM json_each(?1))) AND (json_array_length(?2) = 0 OR severity IN (SELECT value FROM json_each(?2))) AND NOT EXISTS (SELECT 1 FROM json_each(?3) AS name JOIN json_each(?4) AS expected ON expected.key = name.key JOIN json_each(?5) AS equal ON equal.key = name.key WHERE (COALESCE(json_extract(alerts.labels, '$.\"' || name.value || '\"'), '') = expected.value) <> equal.value) AND (?6 IS NULL OR EXISTS (SELECT 1 FROM notifications WHERE notifications.dedupe_key = 'a:' || alerts.fingerprint AND notifications.state = ?6)) ORDER BY last_seen_at DESC, fingerprint LIMIT ?7",
